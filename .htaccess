Options -Indexes

RewriteEngine On

# Impede o acesso direto ao código, às configurações e a arquivos internos.
RewriteRule ^(?:app|config|core|database|vendor|tests|scripts|docs|dist|\.runtime)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(?:zip|sql|md|lock|json|ps1)$ - [F,L,NC]
RewriteRule ^(?:\.git|composer\.(?:json|lock)|README\.md|desktop\.ini)$ - [F,L,NC]

# Mantém os arquivos públicos disponíveis sem expor o restante do projeto.
RewriteRule ^(css|js|uploads)/(.*)$ public/$1/$2 [END,NC]

# A pasta public é usada apenas internamente pelo encaminhamento acima.
# REQUEST_URI preserva a URL original, então arquivos estáticos internos
# como /css/main.css não são bloqueados.
RewriteCond %{REQUEST_URI} ^/public(?:/|$) [NC]
RewriteRule ^ - [F,L]

# Todas as demais requisições passam pelo front controller da raiz.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?rota=$1 [QSA,L]
